[Unit]
Description=Ascender Ledger web interface
Requires=ledger-db.container
After=ledger-db.container

[Container]
ContainerName=ledger-web
Image=ledger-web.build
PublishPort=80:80
PublishPort=443:443
Environment=MYSQL_LEDGER_PASSWORD=/run/secrets/db-ledger-password
Network=ledger.network
Secret=db-ledger-password
Secret=firstkey
Secret=secondkey
Volume=../src:/var/www/html:z
# TLS certificate and key for the HTTPS listener, generated by install.sh when
# they are not supplied.  Read-only: nginx never writes to them.
Volume=../certs:/etc/nginx/certs:ro,z
# The checkout is bind mounted over /var/www/html, which would hide the vendor
# directory that composer install created in the image.  Keep it in a named
# volume that Podman seeds from the image on first use.
Volume=ledger-vendor.volume:/var/www/html/vendor:z

[Service]
TimeoutStartSec=900

[Install]
WantedBy=default.target
